{
  "openapi": "3.1.0",
  "info": {
    "title": "Transit Delay Backend",
    "description": "Приём телеметрии NDTP, наложение на нитку графика, прогноз отклонения за 10–15 минут, алерты и API диспетчерского дашборда.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Состояние потока, ML и сервиса",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/state": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Снимок для дашборда (то же приходит по WebSocket /ws)",
        "operationId": "state_api_state_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response State Api State Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/vehicles": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Все ТС с текущим прогнозом",
        "operationId": "vehicles_api_vehicles_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response Vehicles Api Vehicles Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/vehicles/{tr_id}": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Детали ТС: трек, ближайшие остановки, история отклонения",
        "operationId": "vehicle_api_vehicles__tr_id__get",
        "parameters": [
          {
            "name": "tr_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Tr Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Vehicle Api Vehicles  Tr Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/routes": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Маршрутная сеть с риском по участкам",
        "operationId": "routes_api_routes_get",
        "parameters": [
          {
            "name": "geometry",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "false — только участки под риском, без геометрии",
              "default": true,
              "title": "Geometry"
            },
            "description": "false — только участки под риском, без геометрии"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response Routes Api Routes Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/alerts": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Инциденты (алерты)",
        "operationId": "alerts_api_alerts_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "active",
                "resolved",
                "all"
              ],
              "type": "string",
              "default": "active",
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response Alerts Api Alerts Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/hotspots": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Проблемные участки: доля рискованных прогнозов, средняя задержка, типичные причины",
        "operationId": "hotspots_api_hotspots_get",
        "parameters": [
          {
            "name": "top",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 15,
              "title": "Top"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response Hotspots Api Hotspots Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Онлайн-MAE, соблюдение горизонта, задержки, пропускная способность",
        "operationId": "metrics_api_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Metrics Api Metrics Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/whatif": {
      "post": {
        "tags": [
          "dashboard"
        ],
        "summary": "What-if: эффект управляющего воздействия на прогноз",
        "operationId": "whatif_api_whatif_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatIfRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Whatif Api Whatif Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/telemetry": {
      "post": {
        "tags": [
          "ingest"
        ],
        "summary": "Приём телеметрии в JSON (исторический датасет без NDTP)",
        "operationId": "telemetry_api_telemetry_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/TelemetryPoint"
                },
                "type": "array",
                "title": "Points"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Telemetry Api Telemetry Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reset": {
      "post": {
        "tags": [
          "service"
        ],
        "summary": "Сбросить оперативное состояние (новая сессия потока)",
        "operationId": "reset_api_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Reset Api Reset Post"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TelemetryPoint": {
        "properties": {
          "unit_id": {
            "type": "integer",
            "title": "Unit Id"
          },
          "event_time": {
            "type": "string",
            "format": "date-time",
            "title": "Event Time",
            "description": "время точки (время потока)"
          },
          "lon": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lon"
          },
          "lat": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "speed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed"
          },
          "heading": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading"
          },
          "location_valid": {
            "type": "boolean",
            "title": "Location Valid",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "unit_id",
          "event_time"
        ],
        "title": "TelemetryPoint",
        "description": "Точка телеметрии в JSON (альтернатива NDTP для подачи исторических данных)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WhatIfRequest": {
        "properties": {
          "tr_id": {
            "type": "integer",
            "title": "Tr Id"
          },
          "scenario": {
            "type": "string",
            "enum": [
              "extra_vehicle",
              "dwell_cut",
              "signal_priority"
            ],
            "title": "Scenario"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "tr_id",
          "scenario"
        ],
        "title": "WhatIfRequest"
      }
    }
  }
}