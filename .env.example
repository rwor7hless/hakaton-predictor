# Путь к распакованному датасету (validate/, test/, train/, labels/, sample_submission.csv)
DATASET_DIR=./data/dataset
# Проигрывание исторического потока
REPLAY_SPEED=10
REPLAY_START=06:30
REPLAY_WARMUP_MIN=20
REPLAY_AUTOSTART=1
# Период прогнозного цикла по часам потока, c
PREDICT_EVERY_S=30
# Порт дашборда на хосте
DASHBOARD_PORT=8080
